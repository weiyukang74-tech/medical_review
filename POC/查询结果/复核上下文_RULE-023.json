      "records": [
        {
          "document_id": "DOC-DS-M-IP-021-117862946-01",
          "updateTime": "2025-07-15 15:27:43",
          "common_content_ref": "MG-002.common_content",
          "unique_content": {
            "基本信息": "婚姻：已婚职业：自由职业者入院日期：2025年06月30日出院日期：2025年07月12日第1次入院住院天数：12天",
            "入院情况": "患者，邓满娟，女性，因“经期延长伴经量增多6年”入妇科。体格检查：体温36.5℃，脉搏70次/分，呼吸20次/分，血压118/83mmHg。一般情况好，妇科检查：外阴：发育正常，阴毛女性分布，呈已婚未产型。未见赘生物。阴道：通畅，粘膜皱襞光滑，未见结节、囊肿，见少量白色分泌物，无明显异味。后穹窿：不饱满，无触痛。宫颈：正常大小，光滑，质地中，无接触性出血，宫口闭，无抬举痛。子宫：前位，正常大小，质中，无压痛，活动度好。双附件：双附件区未及明显包块，无压痛。2025-06-29 经阴道B超：子宫内膜呈息肉样变：子宫内膜息肉？其他？子宫下段剖宫产切口处少量积液，考虑切口憩室。右侧卵巢囊肿。",
            "入院诊断": "1、异常子宫出血：子宫内膜息肉？,2、子宫瘢痕憩室,3、卵巢囊肿(右侧),4、瘢痕子宫",
            "诊疗经过": "入院后完善相关检验检查，2025-07-02行(子宫,腹部,右侧卵巢,左侧输卵管)经宫腔镜子宫内膜息肉切除术+腹腔镜子宫陈旧性产科裂伤修补术+经腹腔镜单侧卵巢囊肿剥除术+宫腔镜宫颈息肉切除术+腹腔镜下单侧输卵管系膜囊肿剥除术+经腹腔镜子宫肌瘤切除术+腹腔镜下盆腔病损切除术+诊断性刮宫术。现术后恢复好，经我科会诊后转入我科。完善术前准备，于2025.7.07日在全麻单孔胸腔镜下行左下肺背段切除术+胸腔粘连松解术，术后对症治疗，复查胸片肺复张尚可，予拔除引流管，出院休养。",
            "出院情况": "患者无诉不适，无咳嗽、咳痰，无发热。",
            "出院诊断": "1、肺原位癌(左下肺（TisN0M0,0期）)  2、卵巢囊肿(右侧)  3、异常子宫出血  4、子宫内膜息肉  5、子宫憩室  6、瘢痕子宫",
            "离院方式": "步行        饮食情况：良好        饮食指导：普通饮食",
            "出院医嘱": "全休壹个月，避免剧烈运动及体力劳动，2-3天换药一次，不适随诊，门诊复诊，相关科室门诊就诊。",
            "其他": "病人去向：回家",
            "医师签名": "刘志新刘志新",
            "上级医生签名": "古琳"
          }
        }
      ]
    }
