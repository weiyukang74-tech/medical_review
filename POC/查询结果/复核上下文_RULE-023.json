{
  "rule_id": "RULE-023",
  "review_basis": {
    "violation_item": "003313010020000-331301002 卵巢囊肿剔除术",
    "violation_description": "患者本次住院【2025-07-02】同时开具【经腹子宫肌瘤剔除术,卵巢囊肿剔除术/经腹子宫肌瘤剔除术,卵巢囊肿剔除术】属同切口手术，同台进行应折价收费",
    "regulatory_claim": "监管系统认定患者在2025-07-02的住院期间，实施了‘经腹子宫肌瘤剔除术’和‘卵巢囊肿剔除术’两项手术。由于这两项手术被判定为‘同切口手术’且‘同台进行’，根据深圳医保规则，应当合并计费或进行折价处理，但当前费用记录显示未执行折价（即可能按两个独立全额项目收费）。",
    "appeal_objective": "证明本次住院中实施的‘经腹子宫肌瘤剔除术’与‘卵巢囊肿剔除术’不符合‘同切口同台手术需折价’的违规条件，或者证明费用结算已符合折价规定。"
  },
  "propositions": [
    {
      "proposition_id": "P01",
      "statement": "本次住院中实施的‘经腹子宫肌瘤剔除术’与‘卵巢囊肿剔除术’并非通过同一手术切口完成，或者并非在同一台手术（同一麻醉/同一手术间连续操作）中进行。",
      "logic_notes": "这是核心事实反驳路径。如果手术切口不同（如一个经腹开腹，一个腹腔镜；或腹部不同位置切口）或分台进行，则不适用同切口折价规则。需要查阅手术记录确认切口位置和手术过程连续性。",
      "missing_required_facts": [],
      "evidence": [
        {
          "一级证据域": "手术操作",
          "二级证据标签": "手术记录",
