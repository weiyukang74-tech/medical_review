{
  "rule_id": "RULE-007",
  "review_basis": {
    "violation_item": "拔牙创面搔刮术",
    "violation_description": "拔牙创面搔刮术含干槽症、拔牙后出血、拔牙创面愈合不良（根据《广东省基本医疗服务价格项目目录（2023年版）》项目内涵或说明规定），拔牙创面搔刮术不能与口腔局部止血同时收费。",
    "regulatory_claim": "监管系统检测到本次就诊中，‘拔牙创面搔刮术’与‘口腔局部止血’项目同时存在收费记录，认为这违反了‘拔牙创面搔刮术’项目内涵已包含止血操作、不得重复收费的规定。",
    "appeal_objective": "证明本次就诊中收取的‘口腔局部止血’费用对应的是超出‘拔牙创面搔刮术’标准内涵的独立医疗行为，或证明两者在时间、操作上具有独立性，从而推翻重复收费的认定。"
  },
  "propositions": [
    {
      "proposition_id": "P01",
      "statement": "本次就诊中实施的‘口腔局部止血’操作超出了‘拔牙创面搔刮术’项目内涵所涵盖的基础止血范围，属于独立的、必要的额外止血措施（如缝合、填塞特殊材料等）。",
      "logic_notes": "这是核心路径。原始描述指出‘拔牙创面搔刮术’包含止血，但未定义止血的边界。如果病历能证明实施了比常规压迫更复杂的独立止血操作，则可能构成单独收费的依据。需通过手术/操作记录来区分‘内含止血’与‘额外止血’。",
